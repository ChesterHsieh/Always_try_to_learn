Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: camera
    Background Color: 32; 32; 32
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: BallMarkers
      Topic:
        Value: /viz_node/markers
        Depth: 10
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: DebugImage
      Topic:
        Value: /ball_detector/debug_image
        Depth: 5
        Reliability Policy: Best Effort
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Name: Current View
