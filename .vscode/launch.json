{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: JAX Basic Main",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/learn-jax/basic/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/learn-jax",
      "justMyCode": true,
      "python": "${workspaceFolder}/learn-jax/.venv/bin/python"
    },
    {
      "name": "Python: Current File (JAX)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/learn-jax",
      "justMyCode": true,
      "python": "${workspaceFolder}/learn-jax/.venv/bin/python"
    },
    {
      "name": "Python: JAX Verify",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/learn-jax/verify_jax.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/learn-jax",
      "justMyCode": true,
      "python": "${workspaceFolder}/learn-jax/.venv/bin/python"
    },
    {
      "name": "Python: JAX Transformer Train",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/learn-jax/transformer/train.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/learn-jax",
      "justMyCode": true,
      "python": "${workspaceFolder}/learn-jax/.venv/bin/python"
    }
  ]
}
