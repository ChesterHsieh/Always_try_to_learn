{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(python -m json.tool*)",
      "Bash(python -m pytest*)",
      "Bash(py -m pytest*)",

      "Bash(uv run*)",
      "Bash(uv pip*)",
      "Bash(uv sync*)",
      "Bash(ruff*)",
      "Bash(make *)",

      "Bash(helm lint*)",
      "Bash(helm template*)",
      "Bash(helm list*)",
      "Bash(helm status*)",
      "Bash(helm get*)",
      "Bash(helm show*)",
      "Bash(helm repo*)",
      "Bash(helm dependency*)",
      "Bash(helm upgrade*)",

      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl top*)",
      "Bash(kubectl config get-contexts*)",
      "Bash(kubectl config current-context*)",
      "Bash(kubectl explain*)",
      "Bash(kubectl version*)",
      "Bash(kubectl api-resources*)",
      "Bash(kubectl rollout*)",

      "Bash(docker images*)",
      "Bash(docker ps*)",
      "Bash(docker inspect*)",
      "Bash(docker logs*)",
      "Bash(docker build*)",

      "Bash(./deploy/scripts/bootstrap-local.sh*)",
      "Bash(./deploy/scripts/run-pipeline.sh*)",
      "Bash(./deploy/scripts/run-smoke-test.sh*)",
      "Bash(./deploy/scripts/check-monitoring-coverage.sh*)",
      "Bash(ai-monitor-system/deploy/scripts/bootstrap-local.sh*)",
      "Bash(ai-monitor-system/deploy/scripts/run-pipeline.sh*)",
      "Bash(ai-monitor-system/deploy/scripts/run-smoke-test.sh*)",
      "Bash(ai-monitor-system/deploy/scripts/check-monitoring-coverage.sh*)",

      "Bash(curl -s http://localhost:*)",
      "Bash(curl -fsS http://localhost:*)",
      "Bash(curl -sf http://localhost:*)",
      "Bash(timeout * kubectl*)",
      "Bash(echo *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(*>.env*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Read(**/.env*)",

      "Bash(helm uninstall*)",
      "Bash(helm delete*)",
      "Bash(docker rm*)",
      "Bash(docker rmi*)",
      "Bash(docker system prune*)",
      "Bash(./deploy/scripts/nuke-local.sh*)",
      "Bash(ai-monitor-system/deploy/scripts/nuke-local.sh*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ruff-autofix.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
